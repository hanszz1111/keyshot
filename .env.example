# ==============================================================================
# AI 白模渲染器 · 环境变量示例
# ==============================================================================
# 用法：把本文件复制为 .env（或直接在系统里设环境变量），按自己的机器改。
# 全部可选 —— 不设就用代码里的默认值（本机路径）。
# ==============================================================================

# --- ComfyUI ---------------------------------------------------------------
# ComfyUI 服务地址。默认 http://127.0.0.1:8188
COMFY_HOST=http://127.0.0.1:8188

# ComfyUI 的 input 目录（图片上传落点）。
# 默认 F:\AI-Renderer\packs\ComfyUI_windows_portable\ComfyUI\input
# 换机器时通常必须改这一项。
COMFY_INPUT_DIR=F:\AI-Renderer\packs\ComfyUI_windows_portable\ComfyUI\input

# --- Blender ----------------------------------------------------------------
# Blender 可执行文件路径。
# 查找顺序：本变量 → PATH 里的 blender → 代码内登记路径 → Program Files
BLENDER_EXE=D:\Dsektop\blender-4.5.0-windows-x64\blender.exe

# --- 控制台本身 --------------------------------------------------------------
# 网页控制台监听端口。默认 8765
RENDERER_PORT=8765

# 设为 1 时启动不自动打开浏览器
RENDERER_NO_BROWSER=0

# 设为 1 时以「控制台模式」运行（用于被其他脚本托管时）
RENDERER_CONSOLE=0
